"use client";
import {useEffect,useMemo,useRef,useState} from "react";
import {Button} from "@/components/ui/button";
import {Input} from "@/components/ui/input";
import {Textarea} from "@/components/ui/textarea";
import {Badge} from "@/components/ui/badge";
import {Progress} from "@/components/ui/progress";
import {toast,Toaster} from "sonner";
import {Activity,Bot,Check,ChevronRight,CircleAlert,Clock3,FileText,LayoutDashboard,MessageSquareText,Plus,Search,Settings2,Sparkles,UploadCloud,UsersRound,WandSparkles,X} from "lucide-react";

type Status="Đang làm"|"Chờ duyệt"|"Đã xong";
type Task={id:number;title:string;owner:string;status:Status;due:string;channel:string};
type Source={id:number;name:string;role:string;company:string;event:string;file:string;excerpt:string;imported:string};
type Rule={id:number;text:string;uses:number};
const initialTasks:Task[]=[{id:1,title:"Key message: Vietnam Growth Summit",owner:"Minh Anh",status:"Chờ duyệt",due:"Hôm nay, 16:00",channel:"LinkedIn"},{id:2,title:"Bài giới thiệu CEO Nguyễn Hải",owner:"Huy",status:"Đang làm",due:"07/10",channel:"Facebook"},{id:3,title:"Email recap Leadership Dinner",owner:"Trang",status:"Đã xong",due:"03/10",channel:"Email"}];
const initialSources:Source[]=[{id:1,name:"Nguyễn Minh Hải",role:"CEO",company:"NovaOne",event:"Vietnam Growth Summit",file:"CEO_Nguyen_Minh_Hai.docx",excerpt:"15 năm xây dựng sản phẩm công nghệ cho thị trường Đông Nam Á. Ưu tiên tăng trưởng bền vững và năng lực lãnh đạo bản địa.",imported:"2 giờ trước"},{id:2,name:"Trần Ngọc Linh",role:"Khách mời",company:"SeedWorks",event:"Leadership Dinner",file:"Guest_Tran_Ngoc_Linh.docx",excerpt:"Nhà đầu tư giai đoạn sớm, tập trung vào AI ứng dụng và chuyển đổi vận hành cho doanh nghiệp vừa.",imported:"Hôm qua"}];
const initialRules:Rule[]=[{id:1,text:"Mở bài đi thẳng vào insight, không dùng câu hỏi tu từ.",uses:12},{id:2,text:"Giọng điệu chuyên gia nhưng tự nhiên; hạn chế tính từ phô trương.",uses:9},{id:3,text:"LinkedIn tối đa 220 từ, luôn có CTA cụ thể ở cuối.",uses:7}];
const statusClass:Record<Status,string>={"Đang làm":"border-blue-200 bg-blue-50 text-blue-700","Chờ duyệt":"border-amber-200 bg-amber-50 text-amber-700","Đã xong":"border-emerald-200 bg-emerald-50 text-emerald-700"};
const nav=[["overview","Tổng quan",LayoutDashboard],["workflow","Công việc",Activity],["sources","Dữ liệu đầu vào",UsersRound],["studio","Content Studio",MessageSquareText],["learning","Feedback của lead",Sparkles],["ai","Kết nối AI",Bot]] as const;

export default function Home(){
 const[tab,setTab]=useState("overview"),[tasks,setTasks]=useState<Task[]>(initialTasks),[sources,setSources]=useState<Source[]>(initialSources),[selected,setSelected]=useState<Source>(initialSources[0]),[rules,setRules]=useState<Rule[]>(initialRules);
 const[draft,setDraft]=useState("Tăng trưởng không còn là cuộc đua của tốc độ đơn thuần. Đó là khả năng đưa ra quyết định đúng khi thị trường thay đổi.\n\nTại Vietnam Growth Summit, anh Nguyễn Minh Hải — CEO NovaOne — sẽ chia sẻ cách một đội ngũ bản địa xây năng lực công nghệ đủ mạnh để mở rộng tại Đông Nam Á, nhưng vẫn giữ kỷ luật vận hành và tăng trưởng bền vững.\n\nHẹn gặp bạn tại phiên thảo luận “Build locally, scale regionally”."),[feedback,setFeedback]=useState(""),[newRule,setNewRule]=useState(""),[accessToken,setAccessToken]=useState(""),[projectId,setProjectId]=useState(""),[location,setLocation]=useState("us-central1"),[baseUrl,setBaseUrl]=useState("https://us-central1-aiplatform.googleapis.com/v1"),[model,setModel]=useState("gemini-2.5-flash"),[connected,setConnected]=useState(false),[busy,setBusy]=useState(false),[importing,setImporting]=useState(false);const fileRef=useRef<HTMLInputElement>(null);
 useEffect(()=>{try{const s=JSON.parse(localStorage.getItem("flowmark")||"null");if(s){setTasks(s.tasks||initialTasks);setSources(s.sources||initialSources);setSelected((s.sources||initialSources)[0]);setRules(s.rules||initialRules);setDraft(s.draft||draft)}}catch{}},[]);
 useEffect(()=>{localStorage.setItem("flowmark",JSON.stringify({tasks,sources,rules,draft}))},[tasks,sources,rules,draft]);
 const completion=useMemo(()=>Math.round(tasks.filter(t=>t.status==="Đã xong").length/tasks.length*100),[tasks]);
 async function importDoc(file?:File){if(!file)return;if(!file.name.toLowerCase().endsWith(".docx"))return toast.error("Vui lòng chọn file Word .docx");setImporting(true);try{const f=new FormData();f.append("file",file);const r=await fetch("/api/import-docx",{method:"POST",body:f});const d=await r.json();if(!r.ok)throw new Error(d.error);const s:Source={id:Date.now(),name:d.title||file.name.replace(/\.docx$/i,""),role:"Khách mời",company:"Chưa phân loại",event:"Vietnam Growth Summit",file:file.name,excerpt:d.text.slice(0,420),imported:"Vừa xong"};setSources(v=>[s,...v]);setSelected(s);setTab("sources");toast.success("Đã đọc và thêm hồ sơ vào kho dữ liệu")}catch(e){toast.error(e instanceof Error?e.message:"Import thất bại")}finally{setImporting(false);if(fileRef.current)fileRef.current.value=""}}
 async function ask(mode:"new"|"revise"|"test"){if(!projectId.trim()||!accessToken.trim())return toast.error("Nhập Project ID và access token trong tab Kết nối AI trước");setBusy(true);try{const prompt=mode==="test"?"Trả lời đúng 1 câu tiếng Việt: Kết nối Marketing Flow Studio đã sẵn sàng.":mode==="revise"?`Bạn là biên tập viên marketing. Sửa bản nháp theo feedback và rule của lead. Chỉ trả về bản hoàn chỉnh.\nNguồn: ${selected.excerpt}\nRules: ${rules.map(r=>r.text).join(" ")}\nFeedback: ${feedback}\nBản nháp: ${draft}`:`Viết bài LinkedIn tiếng Việt tối đa 220 từ cho event ${selected.event}. Dựa đúng dữ liệu nguồn, không tự bịa. Áp dụng rule lead. Chỉ trả về bài hoàn chỉnh.\nNguồn: ${selected.excerpt}\nRules: ${rules.map(r=>r.text).join(" ")}`;const r=await fetch("/api/vertex",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({accessToken,projectId,location,baseUrl,model,prompt})});const d=await r.json();if(!r.ok)throw new Error(d.error);if(mode==="test"){setConnected(true);toast.success(d.text)}else{setDraft(d.text);setTab("studio");toast.success(mode==="revise"?"Đã sửa theo feedback":"Đã tạo bản nháp mới")}}catch(e){setConnected(false);toast.error(e instanceof Error?e.message:"Không thể kết nối Vertex AI")}finally{setBusy(false)}}
 return <div className="min-h-screen bg-[#f3f5f8] text-slate-950"><Toaster richColors position="top-right"/><input ref={fileRef} type="file" accept=".docx" className="hidden" onChange={e=>importDoc(e.target.files?.[0])}/>
 <aside className="fixed inset-y-0 left-0 z-30 hidden w-[252px] flex-col border-r border-slate-800 bg-[#111927] px-4 py-5 text-white lg:flex"><div className="mb-7 flex items-center gap-3 px-2"><div className="grid h-10 w-10 place-items-center rounded-xl bg-[#d7ff4f] text-slate-950"><WandSparkles size={20}/></div><div><div className="font-semibold">Flowmark</div><div className="text-xs text-slate-400">Marketing workspace</div></div></div><nav className="space-y-1">{nav.map(([id,label,Icon])=><button key={id} onClick={()=>setTab(id)} className={`flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-left text-sm ${tab===id?"bg-white text-slate-950":"text-slate-300 hover:bg-white/10"}`}><Icon size={18}/>{label}{id==="workflow"&&<span className="ml-auto rounded-full bg-[#d7ff4f] px-2 py-0.5 text-[11px] font-bold text-slate-950">3</span>}</button>)}</nav><div className="mt-auto rounded-2xl border border-white/10 bg-white/5 p-3"><div className="mb-2 flex justify-between text-xs"><span>Tiến độ tuần</span><b className="text-[#d7ff4f]">{completion}%</b></div><Progress value={completion} className="h-1.5"/><p className="mt-3 text-xs leading-5 text-slate-400">Tự động lưu trên trình duyệt này.</p></div></aside>
 <main className="lg:pl-[252px]"><header className="sticky top-0 z-20 flex h-[72px] items-center justify-between border-b bg-white/90 px-5 backdrop-blur md:px-8"><div><p className="text-xs font-medium uppercase tracking-[.16em] text-slate-400">Workspace / Q4 campaigns</p><h1 className="text-lg font-semibold">{nav.find(n=>n[0]===tab)?.[1]}</h1></div><div className="flex gap-2"><button className="hidden h-9 items-center gap-2 rounded-lg border px-3 text-sm text-slate-500 md:flex"><Search size={16}/>Tìm nhanh</button><Button onClick={()=>fileRef.current?.click()} disabled={importing} className="bg-[#111927]"><UploadCloud size={16}/>{importing?"Đang đọc…":"Import .docx"}</Button></div></header>
 <div className="mx-auto max-w-[1440px] p-4 md:p-8"><div className="mb-5 flex gap-2 overflow-x-auto lg:hidden">{nav.map(([id,label])=><button key={id} onClick={()=>setTab(id)} className={`whitespace-nowrap rounded-full px-3 py-2 text-sm ${tab===id?"bg-slate-950 text-white":"bg-white"}`}>{label}</button>)}</div>
 {tab==="overview"&&<Overview tasks={tasks} completion={completion} go={setTab}/>} {tab==="workflow"&&<Workflow tasks={tasks} setTasks={setTasks}/>} {tab==="sources"&&<Sources sources={sources} selected={selected} setSelected={setSelected} onImport={()=>fileRef.current?.click()} go={()=>setTab("studio")}/>} {tab==="studio"&&<Studio draft={draft} setDraft={setDraft} feedback={feedback} setFeedback={setFeedback} source={selected} busy={busy} generate={()=>ask("new")} revise={()=>ask("revise")} learn={()=>{if(!feedback.trim())return toast.error("Nhập feedback trước");setRules(v=>[{id:Date.now(),text:feedback.trim(),uses:0},...v]);setFeedback("");toast.success("Đã học feedback thành rule")}}/>} {tab==="learning"&&<Learning rules={rules} setRules={setRules} value={newRule} setValue={setNewRule}/>} {tab==="ai"&&<AI accessToken={accessToken} setAccessToken={setAccessToken} projectId={projectId} setProjectId={setProjectId} location={location} setLocation={setLocation} baseUrl={baseUrl} setBaseUrl={setBaseUrl} model={model} setModel={setModel} connected={connected} busy={busy} test={()=>ask("test")}/>}</div></main></div>
}

function Overview({tasks,completion,go}:{tasks:Task[];completion:number;go:(s:string)=>void}){return <div className="space-y-6"><section className="rounded-[24px] bg-[#111927] p-6 text-white md:p-8"><div className="grid gap-6 md:grid-cols-[1fr_auto]"><div><Badge className="mb-4 bg-white/10 text-white">Tuần 05–11/10</Badge><h2 className="max-w-2xl text-2xl font-semibold leading-tight md:text-4xl">Biến dữ liệu khách mời thành content sẵn sàng để lead duyệt.</h2><p className="mt-3 max-w-xl text-sm leading-6 text-slate-300">Một luồng xuyên suốt từ import hồ sơ, lên nội dung bằng Gemini, nhận feedback đến tái sử dụng guideline.</p></div><div className="flex min-w-44 flex-col justify-between rounded-2xl bg-[#d7ff4f] p-5 text-slate-950"><span className="text-sm font-medium">Tiến độ content</span><strong className="text-5xl">{completion}%</strong><button onClick={()=>go("workflow")} className="flex items-center gap-1 text-sm font-semibold">Xem công việc<ChevronRight size={16}/></button></div></div></section><div className="grid gap-4 md:grid-cols-4">{[["12","Nội dung tháng này","+18%"],["3","Chờ lead duyệt","Cần xử lý"],["8","Hồ sơ đã import","2 mới"],["21","Feedback đã học","+4 tuần này"]].map(([v,l,n],i)=><div key={l} className="rounded-2xl border bg-white p-5"><div className="mb-5 flex justify-between"><span className={`h-2.5 w-2.5 rounded-full ${["bg-blue-500","bg-amber-500","bg-violet-500","bg-emerald-500"][i]}`}/><span className="text-xs text-slate-400">{n}</span></div><div className="text-3xl font-semibold">{v}</div><div className="mt-1 text-sm text-slate-500">{l}</div></div>)}</div><section className="rounded-2xl border bg-white p-5"><div className="mb-4 flex justify-between"><div><h3 className="font-semibold">Cần bạn xử lý</h3><p className="text-sm text-slate-500">Gần deadline và đang chờ duyệt.</p></div><button onClick={()=>go("workflow")} className="text-sm font-semibold">Xem tất cả</button></div><TaskTable tasks={tasks}/></section></div>}
function TaskTable({tasks}:{tasks:Task[]}){return <div className="overflow-x-auto"><table className="w-full min-w-[720px] text-left text-sm"><thead className="border-y bg-slate-50 text-xs uppercase text-slate-400"><tr><th className="px-3 py-3">Nội dung</th><th>Owner</th><th>Kênh</th><th>Deadline</th><th>Trạng thái</th></tr></thead><tbody>{tasks.map(t=><tr key={t.id} className="border-b last:border-0"><td className="px-3 py-4 font-medium">{t.title}</td><td>{t.owner}</td><td>{t.channel}</td><td className="text-slate-500">{t.due}</td><td><Badge variant="outline" className={statusClass[t.status]}>{t.status}</Badge></td></tr>)}</tbody></table></div>}
function Workflow({tasks,setTasks}:{tasks:Task[];setTasks:(v:Task[])=>void}){const cols:Status[]=["Đang làm","Chờ duyệt","Đã xong"];return <div><div className="mb-6 flex items-end justify-between"><div><h2 className="text-2xl font-semibold">Content pipeline</h2><p className="text-sm text-slate-500">Theo dõi từ bản nháp đến phê duyệt.</p></div><Button onClick={()=>setTasks([...tasks,{id:Date.now(),title:"Nội dung mới",owner:"Bạn",status:"Đang làm",due:"Chưa đặt",channel:"LinkedIn"}])}><Plus size={16}/>Thêm task</Button></div><div className="grid gap-4 lg:grid-cols-3">{cols.map((status,i)=><section key={status} className="rounded-2xl bg-slate-200/60 p-3"><div className="mb-3 flex justify-between px-1"><b>{status}</b><span className="rounded-full bg-white px-2 py-1 text-xs">{tasks.filter(t=>t.status===status).length}</span></div><div className="space-y-3">{tasks.filter(t=>t.status===status).map(t=><article key={t.id} className="rounded-xl border bg-white p-4"><div className="mb-3 flex justify-between"><Badge variant="outline">{t.channel}</Badge><Settings2 size={16} className="text-slate-400"/></div><h3 className="font-medium">{t.title}</h3><div className="mt-4 flex justify-between text-xs text-slate-500"><span>{t.owner}</span><span className="flex gap-1"><Clock3 size={13}/>{t.due}</span></div>{i<2&&<button onClick={()=>setTasks(tasks.map(x=>x.id===t.id?{...x,status:cols[i+1]}:x))} className="mt-4 w-full rounded-lg bg-slate-100 py-2 text-xs font-semibold">Chuyển sang {cols[i+1]}</button>}</article>)}</div></section>)}</div></div>}
function Sources({sources,selected,setSelected,onImport,go}:{sources:Source[];selected:Source;setSelected:(s:Source)=>void;onImport:()=>void;go:()=>void}){return <div className="grid gap-5 xl:grid-cols-[1fr_380px]"><section><div className="mb-5 flex items-end justify-between"><div><h2 className="text-2xl font-semibold">Kho dữ liệu khách mời</h2><p className="text-sm text-slate-500">Import Word để tạo nguồn sự thật cho từng bài viết.</p></div><Button onClick={onImport}><UploadCloud size={16}/>Import Word</Button></div><div className="grid gap-4 md:grid-cols-2">{sources.map(s=><button key={s.id} onClick={()=>setSelected(s)} className={`rounded-2xl border bg-white p-5 text-left ${selected.id===s.id?"border-slate-950 ring-2 ring-slate-950/10":""}`}><div className="flex justify-between"><div className="grid h-11 w-11 place-items-center rounded-xl bg-violet-100 text-violet-700"><FileText size={21}/></div><Badge variant="outline">{s.role}</Badge></div><h3 className="mt-5 font-semibold">{s.name}</h3><p className="text-sm text-slate-500">{s.company} · {s.event}</p><p className="mt-4 line-clamp-3 text-sm leading-6 text-slate-600">{s.excerpt}</p><div className="mt-4 border-t pt-3 text-xs text-slate-400">{s.file} · {s.imported}</div></button>)}</div></section><aside className="h-fit rounded-2xl border bg-white p-5 xl:sticky xl:top-24"><span className="text-xs font-semibold uppercase tracking-wider text-slate-400">Hồ sơ đang chọn</span><h3 className="mt-3 text-xl font-semibold">{selected.name}</h3><p className="text-sm text-slate-500">{selected.role} tại {selected.company}</p><div className="my-5 rounded-xl bg-slate-50 p-4 text-sm leading-6 text-slate-600">{selected.excerpt}</div><Button onClick={go} className="w-full bg-[#d7ff4f] text-slate-950 hover:bg-lime-300"><WandSparkles size={16}/>Dùng để viết content</Button></aside></div>}
function Studio({draft,setDraft,feedback,setFeedback,source,busy,generate,revise,learn}:{draft:string;setDraft:(s:string)=>void;feedback:string;setFeedback:(s:string)=>void;source:Source;busy:boolean;generate:()=>void;revise:()=>void;learn:()=>void}){return <div className="grid gap-5 xl:grid-cols-[1fr_390px]"><section className="rounded-2xl border bg-white"><div className="flex items-center justify-between border-b p-4"><div><Badge>LinkedIn</Badge><span className="ml-2 text-sm font-semibold">{source.event}</span><p className="mt-1 text-xs text-slate-400">Nguồn: {source.name}</p></div><Button onClick={generate} disabled={busy} variant="outline"><Sparkles size={16}/>{busy?"Gemini đang viết…":"Tạo bản mới"}</Button></div><Textarea value={draft} onChange={e=>setDraft(e.target.value)} className="min-h-[520px] resize-none border-0 p-6 text-base leading-8 shadow-none focus-visible:ring-0"/><div className="flex justify-between border-t p-4 text-xs text-slate-400"><span>{draft.trim().split(/\s+/).length} từ · Tự động lưu</span><span className="flex gap-1 text-emerald-600"><Check size={14}/>Đã lưu</span></div></section><aside className="space-y-4"><section className="rounded-2xl border bg-white p-5"><h3 className="mb-4 font-semibold">Feedback của lead</h3><Textarea value={feedback} onChange={e=>setFeedback(e.target.value)} placeholder="VD: Giảm tính quảng cáo, đưa insight của CEO lên mở bài…" className="min-h-36"/><div className="mt-3 grid grid-cols-2 gap-2"><Button variant="outline" onClick={learn}>Lưu thành rule</Button><Button onClick={revise} disabled={busy}><WandSparkles size={16}/>Sửa theo feedback</Button></div></section><section className="rounded-2xl border border-amber-200 bg-amber-50 p-5"><div className="flex gap-3"><CircleAlert className="text-amber-700" size={18}/><div><h3 className="font-semibold">Kiểm tra trước khi duyệt</h3><ul className="mt-2 space-y-2 text-sm text-amber-900/75"><li>• Tên và chức danh khớp nguồn</li><li>• Không có số liệu tự thêm</li><li>• CTA đúng kênh</li></ul></div></div></section></aside></div>}
function Learning({rules,setRules,value,setValue}:{rules:Rule[];setRules:(v:Rule[])=>void;value:string;setValue:(s:string)=>void}){return <div className="mx-auto max-w-4xl"><h2 className="text-2xl font-semibold">Bộ nhớ feedback của lead</h2><p className="mb-6 mt-1 text-sm text-slate-500">Mỗi feedback được lưu thành rule và chèn vào prompt khi Gemini viết hoặc sửa bài.</p><div className="mb-5 flex gap-2 rounded-2xl border bg-white p-3"><Input value={value} onChange={e=>setValue(e.target.value)} placeholder="Thêm nguyên tắc biên tập…" className="border-0"/><Button onClick={()=>{if(!value.trim())return;setRules([{id:Date.now(),text:value.trim(),uses:0},...rules]);setValue("")}}><Plus size={16}/>Thêm rule</Button></div><div className="space-y-3">{rules.map((r,i)=><article key={r.id} className="flex items-start gap-4 rounded-2xl border bg-white p-5"><div className="grid h-9 w-9 place-items-center rounded-full bg-[#d7ff4f] text-sm font-bold">{String(i+1).padStart(2,"0")}</div><div className="flex-1"><p>{r.text}</p><p className="mt-2 text-xs text-slate-400">Đã áp dụng {r.uses} lần</p></div><button onClick={()=>setRules(rules.filter(x=>x.id!==r.id))} className="p-2 text-slate-400"><X size={17}/></button></article>)}</div></div>}
function AI({accessToken,setAccessToken,projectId,setProjectId,location,setLocation,baseUrl,setBaseUrl,model,setModel,connected,busy,test}:{accessToken:string;setAccessToken:(s:string)=>void;projectId:string;setProjectId:(s:string)=>void;location:string;setLocation:(s:string)=>void;baseUrl:string;setBaseUrl:(s:string)=>void;model:string;setModel:(s:string)=>void;connected:boolean;busy:boolean;test:()=>void}){return <div className="mx-auto max-w-3xl"><h2 className="text-2xl font-semibold">Kết nối Vertex AI</h2><p className="mb-6 mt-1 text-sm text-slate-500">Kết nối tài khoản Google Cloud Vertex AI để đọc nguồn và tạo content trong workflow.</p><section className="rounded-2xl border bg-white p-6"><div className="mb-6 flex items-center justify-between rounded-xl bg-slate-50 p-4"><div className="flex items-center gap-3"><div className="grid h-10 w-10 place-items-center rounded-xl bg-blue-100 text-blue-700"><Bot size={21}/></div><div><h3 className="font-semibold">Google Cloud Vertex AI</h3><p className="text-sm text-slate-500">Publisher model · generateContent</p></div></div><Badge className={connected?"bg-emerald-100 text-emerald-700":"bg-slate-200 text-slate-600"}>{connected?"Đã kết nối":"Chưa kiểm tra"}</Badge></div><div className="grid gap-5 md:grid-cols-2"><div><label className="mb-2 block text-sm font-medium">Project ID</label><Input value={projectId} onChange={e=>{setProjectId(e.target.value);setConnected(false)}} placeholder="my-gcp-project"/></div><div><label className="mb-2 block text-sm font-medium">Location</label><Input value={location} onChange={e=>{const value=e.target.value;setLocation(value);setBaseUrl(`https://${value || "us-central1"}-aiplatform.googleapis.com/v1`);setConnected(false)}} placeholder="us-central1"/></div></div><label className="mb-2 mt-5 block text-sm font-medium">Base URL</label><Input value={baseUrl} onChange={e=>{setBaseUrl(e.target.value);setConnected(false)}} placeholder="https://us-central1-aiplatform.googleapis.com/v1"/><p className="mt-2 text-xs leading-5 text-slate-400">Endpoint Vertex AI theo region của project.</p><label className="mb-2 mt-5 block text-sm font-medium">OAuth access token</label><Input type="password" value={accessToken} onChange={e=>{setAccessToken(e.target.value);setConnected(false)}} placeholder="ya29…"/><p className="mt-2 text-xs leading-5 text-slate-400">Token chỉ giữ trong bộ nhớ phiên, không lưu vào localStorage.</p><label className="mb-2 mt-5 block text-sm font-medium">Model</label><Input value={model} onChange={e=>{setModel(e.target.value);setConnected(false)}} placeholder="gemini-2.5-flash"/><div className="mt-6 flex items-center justify-between gap-4 border-t pt-5"><span className="text-sm text-slate-500">Nhập thông tin Vertex account rồi kiểm tra trước khi dùng.</span><Button onClick={test} disabled={busy}>{busy?"Đang kiểm tra…":"Kiểm tra kết nối"}</Button></div></section><section className="mt-4 rounded-2xl border bg-white p-5"><h3 className="font-semibold">Luồng dữ liệu</h3><div className="mt-4 flex flex-wrap items-center gap-2 text-sm"><Badge variant="outline">File Word</Badge><ChevronRight size={15}/><Badge variant="outline">Hồ sơ nguồn</Badge><ChevronRight size={15}/><Badge variant="outline">Vertex AI</Badge><ChevronRight size={15}/><Badge variant="outline">Lead feedback</Badge><ChevronRight size={15}/><Badge className="bg-[#d7ff4f] text-slate-950">Rule tái sử dụng</Badge></div></section></div>}
